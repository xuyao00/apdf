{
  "name": "apdf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A quiet, cross-platform PDF reader for research.",
  "author": "aPDF contributors",
  "license": "LGPL-3.0-only",
  "main": "electron/main.cjs",
  "desktopName": "apdf.desktop",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node scripts/smoke.mjs",
    "test:e2e:dev": "node scripts/smoke.mjs --dev",
    "icons:mac": "node scripts/build-icons.mjs",
    "dist:mac": "npm run icons:mac && npm run build && electron-builder --mac dmg zip --universal --publish never",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64 --arm64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux tar.gz --x64 --arm64 --publish never && node scripts/package-deb.mjs",
    "dist:desktop": "npm run build && electron-builder --win nsis portable --linux tar.gz --x64 --arm64 --publish never && node scripts/package-deb.mjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "org.apdf.reader",
    "productName": "aPDF",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE",
      "COPYING",
      "NOTICE"
    ],
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "toolsets": {
      "nsis": "1.2.1"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Install ${productName}",
      "icon": "build/icon.icns",
      "backgroundColor": "#f6f6f6",
      "iconSize": 104,
      "iconTextSize": 13,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 175,
          "type": "file"
        },
        {
          "x": 390,
          "y": 175,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "executableName": "aPDF",
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-Windows-${arch}-Setup.${ext}",
      "buildUniversalInstaller": false,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-Windows-${arch}-Portable.${ext}",
      "buildUniversalInstaller": false
    },
    "linux": {
      "icon": "build/icon.png",
      "executableName": "apdf",
      "artifactName": "${productName}-${version}-Linux-${arch}.${ext}",
      "target": [
        "tar.gz"
      ],
      "category": "Office",
      "syncDesktopName": true
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF document",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ]
  }
}
